# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template is documentation, not a secret, and without it nobody
# deploying this can tell which variables the app needs.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# menu workspaces: restaurant data + a python venv, not code
/menus/*
!/menus/README.md
!/menus/.tools/
/menus/.tools/.venv/
/menus/.tools/__pycache__/

# print agent binaries: built with print-agent/build.sh, published outside git
/print-agent/dist/

# supabase CLI link state (created by `supabase link`; per machine)
/supabase/.temp/

# native shells (native/): dependencies, build output and per-machine files
/native/*/node_modules/
/native/plugins/*/node_modules/
/native/desktop/dist/
/native/desktop/agent/
/native/*/ios/App/build/
/native/*/ios/App/Pods/
/native/*/ios/App/App.xcworkspace/xcuserdata/
/native/*/ios/App/App.xcodeproj/xcuserdata/
/native/*/ios/App/App.xcodeproj/project.xcworkspace/xcuserdata/
/native/*/ios/App/CapApp-SPM/.build/
/native/*/android/.gradle/
/native/*/android/build/
/native/*/android/app/build/
/native/*/android/capacitor-cordova-android-plugins/build/
/native/*/android/local.properties
/native/*/android/.idea/
/native/*/android/*.iml
/native/*/android/app/*.iml
# Firebase / signing material: never committed
/native/mobile/android/app/google-services.json
/native/*/android/*.keystore
/native/*/android/*.jks
/native/plugins/*/android/build/
/native/plugins/*/android/.gradle/
/native/keys/*
!/native/keys/README.md
/native/*/assets/
