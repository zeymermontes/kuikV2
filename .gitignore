# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template is documentation, not a secret, and without it nobody
# deploying this can tell which variables the app needs.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# menu workspaces: restaurant data + a python venv, not code
/menus/*
!/menus/README.md
!/menus/.tools/
/menus/.tools/.venv/
/menus/.tools/__pycache__/

# print agent binaries: built with print-agent/build.sh, published outside git
/print-agent/dist/
