# ═══════════════════════════════════════════════════════════════════════════
#  Kuik — environment variables
#  Copy this file to .env.local and fill in real values. Variables prefixed with
#  NEXT_PUBLIC_ are exposed to the browser; everything else is server-only.
# ═══════════════════════════════════════════════════════════════════════════

# ─── Supabase ────────────────────────────────────────────────────────────────
# Your Supabase project URL (Project Settings → API). Used by every client.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Public anon key. Safe for the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service-role key — BYPASSES RLS. Server-only. Used for public menu reads,
# logging anonymous views/orders, the MercadoPago webhook, and super-admin ops.
# Never expose this to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── App / domains ───────────────────────────────────────────────────────────
# Root domain, NO protocol. Drives subdomain tenant routing in proxy.ts.
#   dev: localhost:3000   |   prod: kuik.mx
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
# Full origin of the dashboard host. Used for absolute redirects (MercadoPago
# back_url) and building webhook URLs.
#   dev: http://localhost:3000   |   prod: https://app.kuik.mx
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── MercadoPago (subscriptions) ─────────────────────────────────────────────
# Access token from your MercadoPago app (server-only). Authenticates the API
# calls that create subscriptions and read their status.
MERCADOPAGO_ACCESS_TOKEN=your-mp-access-token
# Public key for any client-side MercadoPago widgets (currently optional).
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=your-mp-public-key
# FALLBACK plan price + currency, used ONLY until the super-admin sets the real
# price in the admin console (stored in the platform_settings table). After that,
# the DB value wins. Edit the live price at app.kuik.mx/admin, not here.
MERCADOPAGO_PLAN_AMOUNT=299
MERCADOPAGO_PRO_AMOUNT=499
MERCADOPAGO_PLAN_CURRENCY=MXN
# Shared secret appended to the webhook URL (?secret=...) so only MercadoPago
# notifications you configured are accepted. Set the same value in the MP dashboard.
MERCADOPAGO_WEBHOOK_SECRET=your-webhook-secret
# Optional: MercadoPago partner/integrator id, sent as x-integrator-id.
MP_INTEGRATOR_ID=
# MercadoPago rejects a non-https back_url (http://localhost fails with
# "Invalid value for back_url"). For LOCAL testing of the subscribe flow, set
# this to a public https URL (e.g. an ngrok tunnel:
# https://abc123.ngrok.io/billing?status=success). In production it's derived
# from NEXT_PUBLIC_APP_URL automatically, so you can leave this unset.
MERCADOPAGO_BACK_URL=

# ─── Cron ────────────────────────────────────────────────────────────────────
# Bearer secret the daily Render cron job sends to /api/cron/expire-trials,
# which flips lapsed trials/subscriptions to past_due.
CRON_SECRET=your-cron-secret

# ─── Secret sealing ──────────────────────────────────────────────────────────
# 32 random bytes, base64. Encrypts secrets Kuik must store but must never leak:
# WhatsApp access tokens and per-tenant AI API keys (see lib/crypto.ts). Kept
# out of Postgres on purpose, so a database dump alone is useless.
#   openssl rand -base64 32
# Changing this makes every already-sealed secret unreadable — rotate via the
# key_version column, never by overwriting this value.
KUIK_SECRET_KEY=

# ─── Web push (avisos a la hostess) ──────────────────────────────────────────
# Generar con:  npx web-push generate-vapid-keys
# OJO: rotar estas llaves invalida TODA suscripción existente — cada dispositivo
# tendría que volver a activar los avisos. El public key se inlinea en el build,
# así que tiene que existir también en el entorno de build de Render.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@kuik.mx
# Ponlo en 1 para registrar el service worker en dev y poder probar el push.
# En dev el worker no cachea nada, solo escucha notificaciones.
NEXT_PUBLIC_SW_DEV=

# ─── WhatsApp Cloud API (bot) ────────────────────────────────────────────────
# Meta app credentials. El alta de números usa Embedded Signup con el camino de
# COEXISTENCE, para que el número siga funcionando en el celular del restaurante.
# Requiere que Kuik esté verificado como negocio y aprobado como Tech Provider.
NEXT_PUBLIC_META_APP_ID=
META_APP_SECRET=
# Config ID del flujo de Embedded Signup, creado en el App Dashboard de Meta.
NEXT_PUBLIC_META_CONFIG_ID=
META_GRAPH_VERSION=v23.0
# Cadena que tú inventas; Meta la repite en el handshake GET del webhook.
WHATSAPP_VERIFY_TOKEN=
# Para probar el webhook en local hace falta una URL pública (p.ej. ngrok)
# apuntando a /api/webhooks/whatsapp.

# ─── Puente whatsmeow (dispositivo vinculado) ────────────────────────────────
# Servicio Go en whatsapp-bridge/. Se conecta escaneando un QR, sin trámites con
# Meta. LEE whatsapp-bridge/README.md: usa un cliente NO oficial, lo cual va
# contra los términos de WhatsApp, y el número que arriesga el baneo es el del
# restaurante. La vía oficial (Cloud API) sigue en el código, oculta.
WHATSAPP_BRIDGE_URL=http://localhost:8080
WHATSAPP_BRIDGE_SECRET=
# Ponlo en 1 para volver a mostrar la conexión por la API oficial de Meta.
NEXT_PUBLIC_WHATSAPP_CLOUD=

# ─── IA del bot ──────────────────────────────────────────────────────────────
# Llaves de Kuik. Cada restaurante puede poner la suya desde el dashboard, y en
# ese caso los topes de costo no aplican (paga él).
AI_DEFAULT_PROVIDER=deepseek
AI_DEEPSEEK_KEY=
AI_OPENAI_KEY=
AI_GEMINI_KEY=
AI_ANTHROPIC_KEY=
AI_KIMI_KEY=
# Voice-note transcription (whisper). Groq preferred, OpenAI fallback.
AI_GROQ_KEY=

# ─── Render (custom domains) ─────────────────────────────────────────────────
# Render API key + web-service id. Used to register a tenant's custom domain on
# the Render service and check its verification status. Leave blank to handle
# custom domains manually (the app degrades gracefully).
RENDER_API_KEY=your-render-api-key
RENDER_SERVICE_ID=srv-xxxxxxxx
